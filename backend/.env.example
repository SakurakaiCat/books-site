# books-api environment configuration — copy to books-api.env and fill in real values
# NOTE: books-api.env is gitignored; never commit real keys or paid download URLs.

# Comma-separated valid premium (爱发电) keys
BOOK_KEYS=MJ-your-premium-key-1,MJ-your-premium-key-2

# Comma-separated premium download URLs (order = index shown after verification).
# These stay server-side only — never bake them into the frontend build.
PREMIUM_DOWNLOAD_URL=https://example.com/premium-download-1,https://example.com/premium-download-2

# HMAC secret for the signed session cookie (falls back to BOOK_KEYS if unset —
# use a distinct secret in production)
SIGNING_SECRET=change-me-to-a-long-random-string

# Free download links (public, shown on the landing page)
# DOWNLOAD_URL_FREE=...

PORT=8787
ALLOWED_ORIGINS=https://your-site.example,http://localhost:4321,http://127.0.0.1:4321
